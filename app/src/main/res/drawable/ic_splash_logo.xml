<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Pill (horizontal capsule)
        Cap radius 11 · center y=35 · x from 26 to 82
        Left cap center (37,35) · Right cap center (71,35)
    -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M37,24 L71,24 A11,11 0 0 1 71,46 L37,46 A11,11 0 0 1 37,24 Z"/>

    <!-- Pill divider — teal matches splash background, splits pill in two halves -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#008080"
        android:strokeWidth="2"
        android:pathData="M54,24 L54,46"/>

    <!--
        Clock face
        Center (54,72) · radius 18 · spans x=36–72, y=54–90
        Built from two clockwise semicircular arcs (left→right through top, right→left through bottom)
    -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M36,72 A18,18 0 0 1 72,72 A18,18 0 0 1 36,72 Z"/>

    <!-- Hour hand — ~10 o'clock: center (54,72) → (47,65) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#008080"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:pathData="M54,72 L47,65"/>

    <!-- Minute hand — ~2 o'clock: center (54,72) → (63,64) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#008080"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M54,72 L63,64"/>

    <!-- Clock center dot -->
    <path
        android:fillColor="#008080"
        android:pathData="M52.5,72 A1.5,1.5 0 0 1 55.5,72 A1.5,1.5 0 0 1 52.5,72 Z"/>

</vector>
